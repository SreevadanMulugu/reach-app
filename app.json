{
  "expo": {
    "name": "Reach",
    "slug": "reach-outreach",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#000000",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.ridhira.reach",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "scheme": "reach-outreach",
    "web": {
      "bundler": "metro"
    }
  }
}
